# Copy to .env and edit. docker compose reads .env automatically.

# Obsidian vault the briefing workflow reads. It needs Tasks/_Tracker.md, Daily/ and Inbox/.
# Defaults to ./example-vault when unset. Use forward slashes on Windows.
VAULT_PATH=C:/Users/you/Documents/SecondBrain

# Time zone for schedules (IANA name).
TIMEZONE=Asia/Kolkata
